# ============================================================
# PDFtool — .gitignore
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environments ──
venv/
.venv/
env/
ENV/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── Build Output ──
frontend/dist/
*.tsbuildinfo

# ── Environment Variables ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── PDFtool Runtime Directories ──
temp_uploads/
converted_files/

# ── Logs ──
*.log
logs/

# ── Testing ──
.coverage
htmlcov/
.pytest_cache/
test_sample.pdf
test_file.txt
test_output.*
test_data.*
test_pres.*

# ── Misc ──
*.bak
*.tmp
*.temp
